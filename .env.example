# CPA 部署环境变量模板 —— 复制为 .env 后填写真实值
# 注意：GITHUB_TOKEN 是你的 GitHub PAT，只留在服务器 .env，绝不上传到公开仓库
COMPOSE_PROJECT_NAME=cpamp
CPAMP_IMAGE=seakee/cpa-manager-plus:latest
CPAMP_PORT=18317
CPA_IMAGE=eceasy/cli-proxy-api:latest
CPA_PORT=8317
# 填入你自己的 GitHub fine-grained PAT（用于插件 store 的 GitHub API 限流规避）
GITHUB_TOKEN=
