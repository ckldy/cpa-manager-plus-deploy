+// A scheduler that errors must not veto a later one that can answer. The error is
+// only surfaced when nobody claimed the request (covered by
+// TestHostPickAuthReturnsSchedulerError for the single-scheduler case).
+func TestHostPickAuthErrorDoesNotBlockAnotherScheduler(t *testing.T) {
 	host := newHostWithRecords(
 		capabilityRecord{
 			id:       "broken",
 			priority: 10,
 			plugin: pluginapi.Plugin{Capabilities: pluginapi.Capabilities{Scheduler: schedulerFunc(func(context.Context, pluginapi.SchedulerPickRequest) (pluginapi.SchedulerPickResponse, error) {
 				return pluginapi.SchedulerPickResponse{}, errors.New("tenant quota exhausted")
 			})}},
 		},
 		capabilityRecord{
 			id:       "healthy",
 			priority: 1,
 			plugin: pluginapi.Plugin{Capabilities: pluginapi.Capabilities{Scheduler: schedulerFunc(func(context.Context, pluginapi.SchedulerPickRequest) (pluginapi.SchedulerPickResponse, error) {
 				return pluginapi.SchedulerPickResponse{Handled: true, AuthID: "auth-healthy"}, nil
 			})}},
 		},
 	)
 
 	resp, handled, errPick := host.PickAuth(context.Background(), schedulerRequest("auth-healthy"))
 	if errPick != nil {
 		t.Fatalf("PickAuth() error = %v, want nil (a healthy scheduler answered)", errPick)
 	}
 	if !handled || resp.AuthID != "auth-healthy" {
 		t.Fatalf("PickAuth() = (%q, %v), want auth-healthy handled", resp.AuthID, handled)
 	}
 }
 
